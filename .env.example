VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# IMPORTANT: Never put the service_role key in client code or .env files committed to source control.
# The service_role key should only be used server-side (e.g., in Supabase Edge Functions).
# Leave VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY empty to use DEMO MODE with local seeded data.
VITE_APP_MODE=demo
